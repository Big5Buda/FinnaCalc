# ── Market data (the ONLY provider: quotes, bars, assets, movers, news) ──
# Free account, no funding needed (a paper-trading account is enough):
# https://alpaca.markets/ → Generate API keys. Every market-data route runs on
# these keys; without them the Investing tab has no prices. Fundamentals
# (sector, beta, dividend yield, P/E, earnings, analyst ratings) are not part
# of Alpaca and are simply not shown.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# ── Chatbot (FinnaBot, Google Gemini) ──
# Free key: https://aistudio.google.com/app/apikey  (looks like "AIza...")
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Portfolio import (Plaid Investments) ──
# Keys: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# "sandbox" (test data, default) or "production"
PLAID_ENV=sandbox

# ── Authentication (Supabase) ──
# Settings → API in your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (Settings → API → service_role). SERVER-ONLY — never expose
# to the client. Used by /api/account/delete to delete a user's account and by
# the SnapTrade session store (lib/snaptrade-session.ts), which keeps brokerage
# credentials server-side in the snaptrade_users table — create it by running
# supabase/snaptrade_users.sql once in the Supabase SQL editor.
SUPABASE_SERVICE_ROLE_KEY=

# ── Waitlist confirmation email (Resend) ──
# Free key: https://resend.com/api-keys. Verify your sending domain in Resend
# (add the SPF/DKIM DNS records it shows to your DNS host). Both vars must be set
# or the confirmation email is silently skipped (signups still save).
RESEND_API_KEY=
# From address; the domain must be verified in Resend. Display name + address:
WAITLIST_FROM_EMAIL="FinnaCalc <finnacalc@felipejmiranda.com>"

# ── Brokerage connections (SnapTrade) ──
# Free dev keys: https://dashboard.snaptrade.com
# Also whitelist your redirect URL (e.g. http://localhost:3000/investing and
# https://www.finnacalc.com/investing) in the SnapTrade dashboard.
# Webhooks: point the SnapTrade Dashboard's Webhooks tab at
# https://www.finnacalc.com/api/snaptrade/webhook — authenticity is verified
# with SNAPTRADE_CONSUMER_KEY (HMAC-SHA256), so no separate webhook secret.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=

# ── Subscriptions (Stripe web checkout — Plus / Trader / Pro) ──
# Keys: https://dashboard.stripe.com/apikeys (test mode first).
# Create 3 products with a monthly + annual price each, paste the price IDs
# below, and point a webhook at https://www.finnacalc.com/api/billing/webhook
# (events: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted) — or run `stripe listen` locally for the
# webhook secret. Entitlements land in the billing_entitlements table:
# run supabase/billing_entitlements.sql once in the Supabase SQL editor.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
STRIPE_PRICE_TRADER_MONTHLY=
STRIPE_PRICE_TRADER_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# ── Company financial statements (/api/statements) ──
# No key and no account: the SEC's XBRL company-facts data is free and public.
# They ask only that automated callers identify themselves, so set this to your
# project and a working contact address. Requests are cached for a day, so the
# SEC sees one call per company per day no matter how much traffic we get.
SEC_CONTACT="FinnaCalc helpfinnacalc@gmail.com"

# The public marketing site, used by /migrate to send someone back once their
# data has been imported (that return trip is what clears the old copy).
NEXT_PUBLIC_SITE_ORIGIN=https://www.finnacalc.com

# Domain a session-hint cookie is scoped to, so the marketing site's header can
# tell whether you're signed in here. One bit, never the session itself.
# Leave unset on localhost, which has no parent domain to share with.
# NEXT_PUBLIC_SESSION_COOKIE_DOMAIN=.finnacalc.com
